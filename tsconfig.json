{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "server/**/*.ts"
  ]
}